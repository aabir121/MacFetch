{
  "manifest_version": 3,
  "name": "MacFetch Download Catcher",
  "version": "1.0.1",
  "description": "Sends Chrome downloads to MacFetch.",
  "permissions": ["downloads", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "MacFetch",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
